rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Entity Validations
    function isValidBank(data) {
      return data.keys().hasAll(['name', 'balance', 'color']) &&
             (data.keys().size() == 3 || (data.keys().size() == 4 && 'initialBalance' in data)) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.balance is number &&
             (!('initialBalance' in data) || data.initialBalance is number) &&
             data.color is string && data.color.size() <= 50;
    }

    function isValidCreditCard(data) {
      return data.keys().hasAll(['name', 'limit', 'used', 'closingDay', 'dueDate', 'color']) &&
             data.keys().size() == 6 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.limit is number && data.limit >= 0 &&
             data.used is number &&
             data.closingDay is int && data.closingDay >= 1 && data.closingDay <= 31 &&
             data.dueDate is int && data.dueDate >= 1 && data.dueDate <= 31 &&
             data.color is string && data.color.size() <= 50;
    }

    function isValidGoal(data) {
      return data.keys().hasAll(['name', 'targetAmount', 'currentAmount', 'color']) &&
             data.keys().size() == 4 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.targetAmount is number && data.targetAmount >= 0 &&
             data.currentAmount is number &&
             data.color is string && data.color.size() <= 50;
    }

    function isValidTransaction(data) {
      let requiredFields = ['date', 'description', 'amount', 'type', 'status', 'category'];
      return data.keys().hasAll(requiredFields) &&
             data.date is string && data.date.size() <= 20 &&
             data.description is string && data.description.size() <= 200 &&
             data.amount is number && data.amount >= 0 &&
             data.status in ['paid', 'pending'] &&
             data.type in ['payable', 'receivable', 'transfer'] &&
             data.category is string && data.category.size() <= 50 &&
             (!('bankId' in data) || (data.bankId is string && data.bankId.size() <= 128)) &&
             (!('cardId' in data) || (data.cardId is string && data.cardId.size() <= 128)) &&
             (!('toBankId' in data) || (data.toBankId is string && data.toBankId.size() <= 128)) &&
             (!('toGoalId' in data) || (data.toGoalId is string && data.toGoalId.size() <= 128)) &&
             (!('isCardBillPayment' in data) || data.isCardBillPayment is bool);
    }

    // Rules
    match /users/{userId} {
      // Banks
      match /banks/{bankId} {
        allow get, delete: if isOwner(userId) && isValidId(bankId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(bankId) && isValidBank(request.resource.data);
        allow update: if isOwner(userId) && isValidId(bankId) && isValidBank(request.resource.data);
      }

      // Cards
      match /cards/{cardId} {
        allow get, delete: if isOwner(userId) && isValidId(cardId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(cardId) && isValidCreditCard(request.resource.data);
        allow update: if isOwner(userId) && isValidId(cardId) && isValidCreditCard(request.resource.data);
      }

      // Goals
      match /goals/{goalId} {
        allow get, delete: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(goalId) && isValidGoal(request.resource.data);
        allow update: if isOwner(userId) && isValidId(goalId) && isValidGoal(request.resource.data);
      }

      // Transactions
      match /transactions/{transactionId} {
        allow get, delete: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(request.resource.data);
        allow update: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(request.resource.data);
      }
    }
  }
}
